generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Runtime do app: endpoint com pooler (PgBouncer em transaction mode).
  url      = env("DATABASE_URL")
  // Migrations: endpoint direto, mesmo host sem o sufixo `-pooler`. O Prisma
  // Migrate usa advisory locks, que são de sessão e não sobrevivem ao
  // transaction pooling — por ali uma migração longa pode travar no meio.
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          Role      @default(CLIENTE)
  accounts      Account[]
  sessions      Session[]
  bookings      Booking[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

enum Role {
  CLIENTE
  BARBEIRO
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// Barbeiro com agenda própria. Separado de `User` de propósito: um barbeiro
/// pode nem ter conta no sistema.
///
/// `calendarToken` é segredo (32 bytes aleatórios em hex). Nunca entra em
/// `select`/`include` que chegue ao client: consultas que cruzam a fronteira
/// pedem só `id` e `name`.
model Barber {
  id            String        @id @default(uuid())
  name          String        @unique
  active        Boolean       @default(true)
  calendarToken String        @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  bookings      Booking[]
  blockedDates  BlockedDate[]
}

model Barbershop {
  id          String              @id @default(uuid())
  name        String
  address     String
  phone       String[]
  description String
  imageUrl    String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  services    BarbershopService[]
}

model BarbershopService {
  id              String           @id @default(uuid())
  barbershopId    String
  name            String
  description     String
  imageUrl        String
  price           Decimal          @db.Decimal(10, 2)
  durationMinutes Int
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  barbershop      Barbershop       @relation(fields: [barbershopId], references: [id])
  // `bookings` é a relação antiga (1 serviço por agendamento) e existe só
  // durante a transição para `bookingServices`. Sai na migração seguinte.
  bookings        Booking[]
  bookingServices BookingService[]
}

model Booking {
  id         String            @id @default(uuid())
  userId     String?
  guestName  String?
  guestPhone String?
  date       DateTime
  status     BookingStatus     @default(CONFIRMADO)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  user       User?             @relation(fields: [userId], references: [id])

  // Duração total do agendamento, congelada no momento da reserva. É a soma
  // das durações dos serviços em `services`, mas guardada aqui de propósito:
  // editar um serviço não pode reescrever a agenda de quem já reservou, e a
  // checagem de conflito precisa do intervalo sem agregar a tabela de junção.
  durationMinutes Int

  services BookingService[]

  // Campos da relação antiga (um serviço por agendamento). Continuam aqui
  // porque esta migração é aditiva: os dados são copiados para
  // `BookingService` e só a migração seguinte remove a coluna.
  serviceId String
  service   BarbershopService @relation(fields: [serviceId], references: [id])

  // Barbeiro que atende. A agenda é por barbeiro: dois agendamentos no mesmo
  // horário só são permitidos se forem de barbeiros diferentes.
  barberId String
  barber   Barber @relation(fields: [barberId], references: [id])

  // Unicidade de (barberId, date) é garantida por um índice único PARCIAL
  // criado via SQL cru na migração `add_barber` (WHERE status <> 'CANCELADO'),
  // de forma que horários cancelados fiquem livres para novo agendamento.
  // Prisma não expressa índice parcial no schema declarativo, por isso ele não
  // aparece como @@unique aqui.
  //
  // A unicidade é por barbeiro e horário, não por (serviço, horário): um Corte
  // e uma Barba às 10:00 com o mesmo barbeiro seriam dois clientes ao mesmo
  // tempo.
  @@index([serviceId, date])
  @@index([barberId, date])
}

/// Serviços de um agendamento. Sem coluna de ordem: a lista é um conjunto, o
/// que o cliente marcou, e a exibição ordena pelo que fizer sentido na tela.
/// A chave composta já garante que o mesmo serviço não entre duas vezes.
model BookingService {
  bookingId String
  serviceId String
  booking   Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service   BarbershopService @relation(fields: [serviceId], references: [id])

  @@id([bookingId, serviceId])
  @@index([serviceId])
}

enum BookingStatus {
  CONFIRMADO
  CONCLUIDO
  CANCELADO
}

/// `barberId` nulo bloqueia a barbearia inteira (feriados e sincronização
/// continuam assim); preenchido bloqueia só aquele barbeiro.
///
/// A unicidade fica em dois índices únicos PARCIAIS criados via SQL cru na
/// migração `add_barber`, porque o Postgres trata NULL como distinto e um
/// `@@unique([date, barberId])` deixaria passar dois bloqueios da barbearia
/// inteira no mesmo dia: `(date) WHERE barberId IS NULL` e
/// `(date, barberId) WHERE barberId IS NOT NULL`.
model BlockedDate {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  reason    String?
  barberId  String?
  barber    Barber?  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([date])
}
