# Copie para .env e preencha. Detalhes de cada variável em DEPLOY.md.

# Banco (Neon). Runtime do app: endpoint COM pooler (host com "-pooler").
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler/neondb?sslmode=require"

# Banco. Só para migrações: endpoint direto, o mesmo host SEM "-pooler".
DIRECT_URL="postgresql://USUARIO:SENHA@HOST/neondb?sslmode=require"

# Auth.js. Gere com: openssl rand -base64 32
AUTH_SECRET=""

# Login com Google (Google Cloud Console > Credenciais > ID do cliente OAuth).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Protege /api/cron/sync-holidays. Segredo longo e aleatório (ex.: openssl rand -hex 32).
CRON_SECRET=""

# Fotos dos serviços (Cloudinary > Settings > API Keys). Sem elas o admin
# continua cadastrando serviços, só não envia foto.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
